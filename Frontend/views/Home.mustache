<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Home Page 1 - Developer Mode</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 1050px;
      margin: 40px auto;
      padding: 0 16px;
      background: #f6f8fb;
      color: #111827;
    }

    .card {
      background: #ffffff;
      border: 1px solid #dbe1ea;
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 16px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    h1, h2, h3 {
      margin-top: 0;
    }

    .muted {
      color: #6b7280;
    }

    label {
      display: block;
      font-weight: 600;
      margin: 10px 0 6px;
    }

    textarea {
      width: 100%;
      min-height: 140px;
      padding: 10px;
      border: 1px solid #cfd8e3;
      border-radius: 10px;
      resize: vertical;
      font: inherit;
    }

    input[type="file"] {
      margin-top: 4px;
    }

    .row {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-top: 14px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 10px 14px;
      border: 0;
      border-radius: 10px;
      cursor: pointer;
      background: #1f2937;
      color: #fff;
      font-weight: 600;
    }

    .pill {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 999px;
      border: 1px solid #d1d5db;
      font-weight: 700;
      margin-right: 8px;
    }

    .pill-true {
      background: #e8fff0;
      border-color: #bde7c9;
      color: #166534;
    }

    .pill-fake {
      background: #ffecec;
      border-color: #f3b2b2;
      color: #991b1b;
    }

    .pill-uncertain {
      background: #fff7e6;
      border-color: #f6d28f;
      color: #92400e;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .metric {
      background: #f9fafb;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 12px;
    }

    .metric-label {
      font-size: 0.9rem;
      color: #6b7280;
      margin-bottom: 6px;
    }

    .metric-value {
      font-size: 1.08rem;
      font-weight: 700;
      word-break: break-word;
    }

    .technical-note {
      background: #f3f4f6;
      border-left: 4px solid #9ca3af;
      padding: 12px;
      border-radius: 8px;
      font-size: 0.95rem;
      line-height: 1.55;
    }

    pre {
      white-space: pre-wrap;
      background: #111827;
      color: #f9fafb;
      padding: 14px;
      border-radius: 12px;
      overflow-x: auto;
      font-size: 0.92rem;
      line-height: 1.5;
    }

    img.gradcam-image {
      max-width: 100%;
      border-radius: 12px;
      border: 1px solid #d1d5db;
      margin-top: 8px;
    }

    @media (max-width: 700px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

{{> navbar}}

<h1>Home Page 1</h1>
<p class="muted">
  Developer mode view showing direct model outputs and raw technical signals.
</p>

<div class="card">
  <form action="/analyze" method="POST" enctype="multipart/form-data">
    <label>Text (required)</label>
    <textarea name="text" required placeholder="Enter claim/text...">{{form_text}}</textarea>

    <label>Image (optional)</label>
    <input type="file" name="image" accept="image/*"/>

    <div class="row">
      <button class="btn" type="submit">Analyze</button>
    </div>
  </form>
</div>

{{#has_result}}
<div class="card">
  <h2>Prediction Output</h2>
  <p>
    <span class="pill
      {{#is_true}}pill-true{{/is_true}}
      {{#is_fake}}pill-fake{{/is_fake}}
      {{#is_uncertain}}pill-uncertain{{/is_uncertain}}">
      {{result_label}}
    </span>
    <span class="muted">Raw confidence: {{raw_confidence}}</span>
  </p>

  <div class="technical-note">
    <strong>Mode:</strong> {{mode}}<br/>
    <strong>Analysis route:</strong> {{analysis_route_label}}<br/>
    <strong>Decision driver:</strong> {{driver_short}}
  </div>
</div>

<div class="card">
  <h3>Raw Model Signals</h3>
  <div class="grid">
    <div class="metric">
      <div class="metric-label">Raw confidence</div>
      <div class="metric-value">{{raw_confidence}}</div>
    </div>

    <div class="metric">
      <div class="metric-label">Raw CLIP similarity (cosine)</div>
      <div class="metric-value">{{raw_clip_similarity}}</div>
    </div>

    <div class="metric">
      <div class="metric-label">Similarity score (0–1)</div>
      <div class="metric-value">{{raw_clip_similarity_01}}</div>
    </div>

    <div class="metric">
      <div class="metric-label">Mismatch score (0–1)</div>
      <div class="metric-value">{{raw_clip_mismatch}}</div>
    </div>

    <div class="metric">
      <div class="metric-label">Text contribution</div>
      <div class="metric-value">{{raw_text_contrib}}</div>
    </div>

    <div class="metric">
      <div class="metric-label">Image contribution</div>
      <div class="metric-value">{{raw_img_contrib}}</div>
    </div>
  </div>
</div>

{{#has_gradcam}}
<div class="card">
  <h3>Visual Output</h3>
  <p><strong>Summary:</strong> {{gradcam_summary}}</p>
  <p><strong>Activation strength:</strong> {{gradcam_strength}}</p>

  {{#has_gradcam_image}}
    <img class="gradcam-image" src="{{gradcam_path}}" alt="Grad-CAM heatmap">
  {{/has_gradcam_image}}
</div>
{{/has_gradcam}}

<div class="card">
  <h3>Raw JSON</h3>
  <pre>{{raw_json}}</pre>
</div>
{{/has_result}}

</body>
</html>